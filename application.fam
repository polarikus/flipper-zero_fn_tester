import os

# Тестовый профиль: FN_TESTS=1 ufbt launch
# Включает юнит-тесты и CLI-команду `fn_test`, оставляя консоль VCP доступной.
_ENABLE_TESTS = os.environ.get("FN_TESTS") == "1"

App(
    appid="fn_test",
    name="FN Tester",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="fn_test_app",
    cdefines=["APP_FN_TEST"] + (["FN_TESTS"] if _ENABLE_TESTS else []),
    # Список исходников задан явно: tests/host — host-тесты для ПК,
    # их нельзя компилировать под ARM.
    sources=[
        "fn_test_app.c",
        "ui/*.c",
        "ui/views/*.c",
        "ui/scenes/*.c",
    ] + (["unit_tests/*.c", "unit_tests/*/*.c", "unit_tests/*/*/*.c", "unit_tests/*/*/*/*.c"] if _ENABLE_TESTS else []),
    requires=[
        "gui",
        "expansion"
    ],
    stack_size=4 * 1024,
    fap_icon="logo_fn.png",
    fap_libs=["assets"],
    fap_description="Tester for fiscal drives (FN/FN-M) of Russian cash registers",
    fap_author="Igor Danilov",
    fap_weburl="https://github.com/polarikus/flipper-zero_fn_tester",
    fap_version=(0, 6, 2),
    order=30,
    fap_category="GPIO",
    fap_icon_assets="icons",
    fap_private_libs=[
            Lib(
                name="fn",
                fap_include_paths=[".", "core", "proto", "transport"],
            )
    ]
)

